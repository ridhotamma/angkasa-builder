{
  "name": "angkasa-builder",
  "version": "0.1.0",
  "description": "A page builder whose pages, sections and editor logic are plain data: render to HTML on any server, wire it up with a small vanilla-JS runtime, and edit it from htmx, vanilla JS or React.",
  "keywords": [
    "page-builder",
    "htmx",
    "storefront",
    "ssr",
    "editor",
    "no-framework"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./editor-core": {
      "types": "./dist/editor-core/index.d.ts",
      "import": "./dist/editor-core/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "import": "./dist/snapshot/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js"
    },
    "./html/runtime": {
      "types": "./dist/html/runtime.d.ts",
      "import": "./dist/html/runtime.js"
    },
    "./quick-checkout": {
      "types": "./dist/quick-checkout/index.d.ts",
      "import": "./dist/quick-checkout/index.js"
    },
    "./page-runtime.js": "./dist/html/page-runtime.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && bun run scripts/build-runtime.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test && bun test ./test/isolated/builder-core.interaction.tsx",
    "example:htmx": "bun run build && bun examples/htmx/server.ts",
    "clean": "rimraf dist",
    "generate:fonts": "bun run scripts/generate-fonts.ts",
    "generate:icons": "bun run scripts/generate-icons.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@internationalized/date": "^3.12.3",
    "@tanstack/react-virtual": "^3.14.14",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "gsap": "^3.15.0",
    "puppeteer-core": "^25.12.0",
    "react-icons": "^5.7.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@chakra-ui/react": ">=3.37.0",
    "@emotion/react": ">=11",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@happy-dom/global-registrator": "^20.14.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.2.23",
    "happy-dom": "^20.14.6",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
